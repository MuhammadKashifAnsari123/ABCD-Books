# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/webscraper
DB_NAME=webscraper

# Reddit API Configuration (Get these from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=WebScraperBot/1.0.0
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# OpenAI Configuration (Get your API key from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key

# Scraping Configuration
SCRAPING_DELAY=1000
MAX_CONCURRENT_REQUESTS=5

# Security
SESSION_SECRET=your_session_secret_here